# Recipe Auto-Creation Service Environment Variables

# Google AI API Key for Gemini integration (REQUIRED)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Database Configuration (REQUIRED for multi-tenant API)
# Get your connection string from Neon/Vercel PostgreSQL dashboard
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Admin API key for client management endpoints (REQUIRED)
ADMIN_API_KEY=your-admin-api-key-for-client-management

# Gemini model override (OPTIONAL, default: gemini-2.5-flash)
# GEMINI_MODEL_NAME=gemini-2.5-pro

# Trusted proxy IPs/CIDRs for X-Forwarded-For handling (OPTIONAL)
# Comma-separated. Required if you sit behind a CDN/load balancer and want
# accurate client IPs for rate limiting.
# TRUSTED_PROXY_IPS=10.0.0.1,192.168.1.0/24,172.16.0.0/16

# Environment flag, only read by admin router (OPTIONAL)
# Set to "test" to enable test-only behavior in admin endpoints.
# ENV=test

# Test mode flag (OPTIONAL, used in CI)
# TESTING=true
